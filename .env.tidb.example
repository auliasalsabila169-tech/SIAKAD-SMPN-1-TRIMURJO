# Contoh konfigurasi koneksi TiDB Cloud (Serverless/Dedicated)
# Isi dari halaman "Connect" di https://tidbcloud.com/ untuk cluster Anda.
#
# Catatan:
# - TiDB Cloud publik biasanya memakai TLS. Simpan CA certificate dari console ke file ca.pem (sudah ada di root proyek ini) atau path lain.
# - DB_HOST biasanya seperti gateway01.<region>.prod.aws.tidbcloud.com
# - DB_PORT untuk MySQL protocol umumnya 4000
# - DB_USERNAME untuk Serverless sering berbentuk <prefix>.root
# - Buat database "siakad_smpn1_trimurjo" terlebih dahulu, atau jalankan scripts/import-to-tidb.ps1

DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=siakad_smpn1_trimurjo
DB_USERNAME=xxxxxxxx.root
DB_PASSWORD=your_password_here

# Path CA certificate untuk koneksi TLS (lihat config/database.php -> MYSQL_ATTR_SSL_CA)
MYSQL_ATTR_SSL_CA=ca.pem
